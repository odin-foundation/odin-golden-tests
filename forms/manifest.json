{
  "$schema": "../forms-suite.schema.json",
  "suite": "forms",
  "description": "ODIN Forms 1.0 parse and render conformance",
  "tests": [
    {
      "id": "page-template-parses",
      "description": "{@tpl_*} page templates parse without error and expose continues/form-id",
      "formFile": "fixtures/page-template.odin",
      "expectParse": {
        "pages": 1,
        "templates": {
          "tpl_vehicles_continued": {
            "pageTemplate": true,
            "continues": "region.vehicles",
            "formId": "PA (Cont)",
            "elementTypes": ["text", "region"]
          }
        },
        "page0": {
          "elementTypes": ["text", "region"],
          "elements": {
            "vehicles": {
              "type": "region",
              "bind": "@policy.vehicles",
              "max": 3,
              "overflow": "@tpl_vehicles_continued",
              "childCount": 1
            }
          }
        }
      }
    },
    {
      "id": "region-overflow-render",
      "description": "Region overflow generates a continuation page from the template; interpolation resolves",
      "formFile": "fixtures/page-template.odin",
      "renderData": "{policy}\n{.vehicles[0]}\nvin = \"V0\"\n{.vehicles[1]}\nvin = \"V1\"\n{.vehicles[2]}\nvin = \"V2\"\n{.vehicles[3]}\nvin = \"V3\"\n{.vehicles[4]}\nvin = \"V4\"",
      "renderContains": [
        "Page 1 of 2",
        "Page 2 of 2",
        "value=\"V0\"",
        "value=\"V3\"",
        "value=\"V4\""
      ],
      "renderNotContains": ["{@odin.page}", "{@odin.total_pages}"]
    },
    {
      "id": "inline-values-parse",
      "description": "Inline value/checked/selected and inputType parse onto field elements",
      "formFile": "fixtures/inline-values.odin",
      "expectParse": {
        "page0": {
          "elements": {
            "name": { "type": "field.text", "value": "John Smith", "inputType": "email" },
            "agree": { "type": "field.checkbox", "checked": true },
            "dob": { "type": "field.date", "value": "1985-03-15", "min": "1900-01-01", "max": "2010-01-01" },
            "state": { "type": "field.select", "selected": "TX", "options": ["AL", "CA", "NY", "TX"] }
          }
        }
      }
    },
    {
      "id": "inline-values-render",
      "description": "Inline values render into HTML inputs without a bound data document",
      "formFile": "fixtures/inline-values.odin",
      "renderContains": [
        "type=\"email\"",
        "value=\"John Smith\"",
        "value=\"1985-03-15\"",
        "<option value=\"TX\" selected>"
      ]
    },
    {
      "id": "content-elements-parse",
      "description": "img background, barcode type, per-side margins, and i18n label refs parse",
      "formFile": "fixtures/content-elements.odin",
      "expectParse": {
        "margins": { "top": 0.5, "right": 0.25, "bottom": 0.6, "left": 0.75 },
        "page0": {
          "elements": {
            "template": { "type": "img", "background": true },
            "doc": { "type": "barcode", "barcodeType": "qr" },
            "name": { "type": "field.text", "label": "Full Legal Name" }
          }
        }
      }
    },
    {
      "id": "content-elements-render",
      "description": "background image gets lowest z-index; barcode carries type and content",
      "formFile": "fixtures/content-elements.odin",
      "renderContains": [
        "z-index:0;",
        "data:image/png;base64,",
        "data-barcode-type=\"qr\"",
        "Full Legal Name"
      ]
    },
    {
      "id": "geometric-elements-parse",
      "description": "circle, ellipse, polygon, polyline, and path elements parse with stroke/fill",
      "formFile": "fixtures/geometric-elements.odin",
      "expectParse": {
        "page0": {
          "elementTypes": ["circle", "ellipse", "polygon", "polyline", "path"],
          "elements": {
            "seal": { "type": "circle" },
            "stamp": { "type": "ellipse" },
            "badge": { "type": "polygon" },
            "trend": { "type": "polyline" },
            "arrow": { "type": "path" }
          }
        }
      }
    },
    {
      "id": "geometric-elements-render",
      "description": "geometric elements render as positioned SVG shapes with converted coordinates",
      "formFile": "fixtures/geometric-elements.odin",
      "renderContains": [
        "<circle cx=\"192\" cy=\"192\" r=\"72\" stroke=\"#003366\"",
        "<ellipse cx=\"480\" cy=\"192\" rx=\"96\" ry=\"48\" stroke=\"#660000\"",
        "<polygon points=\"96,384 192,384 240,480 144,528 48,480\" stroke=\"#000000\"",
        "<polyline points=\"288,384 336,441.6 384,403.2 432,480 480,412.8\" stroke=\"#006600\" stroke-width=\"1.92\" fill=\"none\"/>",
        "<path d=\"M 6,4 L 7,4 L 6.5,5 Z\" stroke=\"#333333\""
      ]
    },
    {
      "id": "signature-radio-parse",
      "description": "radio fields carry group/value; signature carries inline value and date_field",
      "formFile": "fixtures/signature-radio.odin",
      "expectParse": {
        "page0": {
          "elements": {
            "gender_m": { "type": "field.radio", "value": "M" },
            "gender_f": { "type": "field.radio", "value": "F" },
            "gender_x": { "type": "field.radio", "value": "X" },
            "applicant_sig": { "type": "field.signature", "value": "^png:iVBORw0KGgo=" },
            "sig_date": { "type": "field.date", "value": "2026-01-15" }
          }
        }
      }
    },
    {
      "id": "signature-radio-render",
      "description": "radio group renders name=/type=radio with the bound option checked; signature renders its capture area",
      "formFile": "fixtures/signature-radio.odin",
      "renderData": "{applicant}\ngender = \"F\"",
      "renderContains": [
        "<input type=\"radio\" class=\"odin-form-radio\" id=\"odin-field-0-gender_m\" name=\"gender\" value=\"M\"",
        "name=\"gender\" value=\"F\" aria-label=\"Female\" checked>",
        "name=\"gender\" value=\"X\" aria-label=\"Nonbinary\">",
        "<div class=\"odin-form-signature\" id=\"odin-field-0-applicant_sig\" aria-label=\"Applicant Signature\" aria-required=\"true\" role=\"img\" tabindex=\"0\"",
        "value=\"2026-01-15\""
      ],
      "renderNotContains": [
        "name=\"gender\" value=\"M\" aria-label=\"Male\" checked"
      ]
    }
  ]
}
