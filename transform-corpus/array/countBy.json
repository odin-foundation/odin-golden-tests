{
  "id": "countBy",
  "family": "array",
  "title": "%countBy - count items per field value",
  "purpose": "Group array items by a field and count how many fall in each group.",
  "signature": "%countBy <array> [<field>] -> object",
  "transform": "{out}\nbyRegion = %countBy @.items \"region\"\nbyValue = %countBy @.tags\nnonArray = %countBy @.notArr",
  "input": "notArr = \"x\"\n\n{items[] : region}\n\"east\"\n\"west\"\n\"east\"\n\n{tags[] : ~}\n\"a\"\n\"b\"\n\"a\"\n\"a\"",
  "expectedOutput": "{out}\nnonArray = ~\n{.byRegion}\neast = ##2\nwest = ##1\n{.byValue}\na = ##3\nb = ##1",
  "notes": [
    "Without a field argument the items themselves are counted. Result keys are sorted."
  ],
  "avoid": []
}
