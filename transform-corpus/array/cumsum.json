{
  "id": "cumsum",
  "family": "array",
  "title": "%cumsum - running total",
  "purpose": "Return the cumulative sum at each position.",
  "signature": "%cumsum <array> -> array",
  "transform": "{out}\nrunning = %cumsum @.values\nwithNeg = %cumsum @.withNeg\nnonArray = %cumsum @.notArr",
  "input": "notArr = \"x\"\n\n{values[] : ~}\n##10\n##20\n##30\n\n{withNeg[] : ~}\n##5\n##-2\n##-10",
  "expectedOutput": "{out}\n{.running[] : ~}\n##10\n##30\n##60\n{.withNeg[] : ~}\n##5\n##3\n##-7\nnonArray = ~",
  "notes": [
    "Each element is the sum of all values up to and including that position."
  ],
  "avoid": []
}
