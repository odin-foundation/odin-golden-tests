{
  "id": "every",
  "family": "array",
  "title": "%every — do all items match a condition",
  "purpose": "Return true when every record satisfies a field condition.",
  "signature": "%every <array> <string:field> <string:op> <value> -> boolean",
  "transform": "{out}\nallActive = %every @.coverages \"status\" \"=\" \"active\"\nnotAll = %every @.mixed \"status\" \"=\" \"active\"\nnonArray = %every @.notArr \"status\" \"=\" \"active\"",
  "input": "notArr = \"x\"\n\n{coverages[] : type, status}\n\"liability\", \"active\"\n\"collision\", \"active\"\n\n{mixed[] : type, status}\n\"liability\", \"active\"\n\"collision\", \"lapsed\"",
  "expectedOutput": "{out}\nallActive = ?true\nnotAll = ?false\nnonArray = ~",
  "notes": [
    "Field, operator, and value are three separate quoted arguments.",
    "An empty array returns ?true (vacuous truth)."
  ],
  "avoid": []
}
