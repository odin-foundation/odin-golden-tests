{
  "id": "cumprod",
  "family": "array",
  "title": "%cumprod - running product",
  "purpose": "Return the cumulative product at each position.",
  "signature": "%cumprod <array> -> array",
  "transform": "{out}\ngrowth = %cumprod @.factors\nwithZero = %cumprod @.withZero\nnonArray = %cumprod @.notArr",
  "input": "notArr = \"x\"\n\n{factors[] : ~}\n#2\n#3\n#4\n\n{withZero[] : ~}\n#2\n#0\n#5",
  "expectedOutput": "{out}\n{.growth[] : ~}\n##2\n##6\n##24\n{.withZero[] : ~}\n##2\n##0\n##0\nnonArray = ~",
  "notes": [
    "Each element is the product of all values up to and including that position."
  ],
  "avoid": []
}
