{
  "id": "partition",
  "family": "array",
  "title": "%partition - split by a condition",
  "purpose": "Divide an array into [matching, non-matching] by a field condition.",
  "signature": "%partition <array> <string:field> <string:op> <value> -> array",
  "transform": "{out}\nsplit = %partition @.coverages \"status\" \"=\" \"active\"\nbyAmount = %partition @.coverages \"premium\" \"<\" \"150\"",
  "input": "{coverages[] : type, status, premium}\n\"liability\", \"active\", ##200\n\"collision\", \"cancelled\", ##100",
  "expectedOutput": "{out}\n{.split[] : [0].type, .status, .premium}\n\"liability\", \"active\", ##200\n\"collision\", \"cancelled\", ##100\n{.byAmount[] : [0].type, .status, .premium}\n\"collision\", \"cancelled\", ##100\n\"liability\", \"active\", ##200",
  "notes": [
    "Returns a two-element array: index 0 is matches, index 1 is the rest.",
    "Field, operator, and value are three separate quoted arguments."
  ],
  "avoid": []
}
