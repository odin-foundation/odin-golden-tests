{
  "id": "businessDays",
  "family": "date",
  "title": "%businessDays — add weekday-only days",
  "purpose": "Shift a date by N business days, skipping Saturdays and Sundays.",
  "signature": "%businessDays <date> <integer:count> -> string",
  "transform": "{out}\nd = %businessDays @.start ##5\noverWeekend = %businessDays @.friday ##1\nback = %businessDays @.friday ##-5\nfromWeekend = %businessDays @.saturday ##1",
  "input": "start = 2024-01-15\nfriday = 2024-01-19\nsaturday = 2024-01-20",
  "expectedOutput": "{out}\nd = \"2024-01-22\"\noverWeekend = \"2024-01-22\"\nback = \"2024-01-12\"\nfromWeekend = \"2024-01-22\"",
  "notes": [
    "Weekends are skipped; there is no holiday calendar.",
    "A negative count subtracts business days."
  ],
  "avoid": []
}
