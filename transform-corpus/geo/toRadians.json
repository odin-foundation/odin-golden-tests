{
  "id": "toRadians",
  "family": "geo",
  "title": "%toRadians - degrees to radians",
  "purpose": "Convert an angle in degrees to radians.",
  "signature": "%toRadians <number:degrees> -> number",
  "transform": "{out}\nrad = %toRadians @.deg\nzero = %toRadians @.zero\nfullTurn = %toRadians @.full",
  "input": "deg = #180\nzero = #0\nfull = #360",
  "expectedOutput": "{out}\nrad = #3.141592653589793\nzero = #0\nfullTurn = #6.283185307179586",
  "notes": [
    "Single numeric argument in degrees; 180 degrees maps to pi radians.",
    "The result is a number (#)."
  ],
  "avoid": []
}
