{
  "category": "export",
  "name": "Export Tests",
  "description": "Transform from ODIN to external formats",
  "tests": [
    {
      "id": "odin-to-json",
      "description": "Export ODIN business data to JSON format",
      "direction": "odin->json",
      "input": "odin-to-json/data.input.odin",
      "transform": "odin-to-json/data.transform.odin",
      "expected": "odin-to-json/data.expected.json"
    },
    {
      "id": "conditional-section-include",
      "description": "Header-inline :if includes a whole section when its condition is true",
      "direction": "odin->json",
      "input": "conditional-section-include/data.input.odin",
      "transform": "conditional-section-include/data.transform.odin",
      "expected": "conditional-section-include/data.expected.json"
    },
    {
      "id": "conditional-section-omit",
      "description": "Header-inline :if omits a whole section when its condition is false",
      "direction": "odin->json",
      "input": "conditional-section-omit/data.input.odin",
      "transform": "conditional-section-omit/data.transform.odin",
      "expected": "conditional-section-omit/data.expected.json"
    },
    {
      "id": "conditional-chain-if",
      "description": "Conditional chain emits the if branch when its condition holds",
      "direction": "odin->json",
      "input": "conditional-chain-if/data.input.odin",
      "transform": "conditional-chain-if/data.transform.odin",
      "expected": "conditional-chain-if/data.expected.json"
    },
    {
      "id": "conditional-chain-elif",
      "description": "Conditional chain falls through to a matching elif branch",
      "direction": "odin->json",
      "input": "conditional-chain-elif/data.input.odin",
      "transform": "conditional-chain-elif/data.transform.odin",
      "expected": "conditional-chain-elif/data.expected.json"
    },
    {
      "id": "conditional-chain-else",
      "description": "Conditional chain emits the else branch when no condition matches",
      "direction": "odin->json",
      "input": "conditional-chain-else/data.input.odin",
      "transform": "conditional-chain-else/data.transform.odin",
      "expected": "conditional-chain-else/data.expected.json"
    },
    {
      "id": "json-nulls-omit",
      "description": "Export ODIN to JSON with null values omitted",
      "direction": "odin->json",
      "input": "json-nulls-omit/data.input.odin",
      "transform": "json-nulls-omit/data.transform.odin",
      "expected": "json-nulls-omit/data.expected.json"
    },
    {
      "id": "json-empty-arrays-omit",
      "description": "Export ODIN to JSON with empty arrays omitted",
      "direction": "odin->json",
      "input": "json-empty-arrays-omit/data.input.odin",
      "transform": "json-empty-arrays-omit/data.transform.odin",
      "expected": "json-empty-arrays-omit/data.expected.json"
    },
    {
      "id": "json-indent-zero",
      "description": "Export ODIN to minified JSON (indent=0)",
      "direction": "odin->json",
      "input": "json-indent-zero/data.input.odin",
      "transform": "json-indent-zero/data.transform.odin",
      "expected": "json-indent-zero/data.expected.json"
    },
    {
      "id": "odin-to-xml",
